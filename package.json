{
  "name": "fire-nepal-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ulimit -n 8192 && WATCHPACK_POLLING=true next dev -H localhost --webpack",
    "dev:3001": "next dev -H localhost -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/membership-sync-architecture.test.mjs scripts/persistence-policy-regression.test.mjs scripts/budget-delete-flow.test.mjs scripts/group-member-delete-flow.test.mjs scripts/security/*.test.mjs scripts/reminders-pipeline.test.mjs scripts/nepse-hub-admin-overrides.test.mjs scripts/homepage-ssr-timeout.test.mjs && npx tsx --test scripts/notification-nav.test.mjs scripts/youtube-videos-flow.test.mjs scripts/blog-posts-flow.test.mjs scripts/ensure-admin-content-sync.test.mjs scripts/homepage-fire-ai.test.mjs scripts/return-checklist.test.mjs scripts/module-snapshots-cache.test.mjs scripts/module-snapshots-client-cache.test.mjs scripts/emergency-fund-plan.test.mjs scripts/historical-finance-analytics.test.mjs scripts/cashflow-income-total.test.mjs scripts/pension-official-policy.test.mjs scripts/fire-lending-member-search.test.mjs scripts/fire-lending-reset-loan-data.test.mjs",
    "test:historical-finance": "npx tsx --test scripts/historical-finance-analytics.test.mjs",
    "test:cashflow-income": "npx tsx --test scripts/cashflow-income-total.test.mjs",
    "test:pension-policy": "npx tsx --test scripts/pension-official-policy.test.mjs",
    "test:return-checklist": "npx tsx --test scripts/return-checklist.test.mjs",
    "test:homepage-ssr-timeout": "node --test scripts/homepage-ssr-timeout.test.mjs",
    "test:homepage-fire-ai": "npx tsx --test scripts/homepage-fire-ai.test.mjs",
    "test:youtube-videos": "npx tsx --test scripts/youtube-videos-flow.test.mjs",
    "db:apply:youtube-videos": "node scripts/apply-youtube-videos-migration.mjs",
    "db:verify:youtube-videos": "node scripts/verify-youtube-videos-crud.mjs",
    "test:blog-posts": "npx tsx --test scripts/blog-posts-flow.test.mjs",
    "db:apply:blog-posts": "node scripts/apply-blog-posts-migration.mjs",
    "db:verify:blog-posts": "node scripts/verify-blog-posts-crud.mjs",
    "db:sync:blog-seed": "npx tsx scripts/sync-seed-blog-posts-production.mjs",
    "db:apply:admin-content": "node scripts/apply-youtube-videos-migration.mjs && node scripts/apply-blog-posts-migration.mjs",
    "db:verify:admin-content": "node scripts/verify-youtube-videos-crud.mjs && node scripts/verify-blog-posts-crud.mjs",
    "test:notification-nav": "npx tsx --test scripts/notification-nav.test.mjs",
    "test:reminders": "node --test scripts/reminders-pipeline.test.mjs",
    "test:reminder-email": "npx tsx --test scripts/reminder-email-lifecycle.test.mjs",
    "verify:production-reminder-emails": "node scripts/verify-production-reminder-emails.mjs",
    "db:apply:reminder-email-lifecycle": "node scripts/apply-scheduled-reminders-email-lifecycle.mjs",
    "test:security": "node --test scripts/security/*.test.mjs",
    "test:persistence": "node --test scripts/persistence-policy-regression.test.mjs scripts/budget-delete-flow.test.mjs scripts/group-member-delete-flow.test.mjs",
    "test:membership-sync": "node --test scripts/membership-sync-architecture.test.mjs",
    "test:nepse-hub-admin-overrides": "node --test scripts/nepse-hub-admin-overrides.test.mjs",
    "test:nepse-index-validation": "npx tsx --test scripts/nepse-official-index-validation.test.mjs",
    "verify:production-membership": "node scripts/verify-production-membership.mjs",
    "generate:investment-registry": "node scripts/generate-investment-registry.mjs",
    "verify:membership-storage": "node scripts/verify-membership-payment-storage.mjs",
    "verify:supabase-auth-env": "node scripts/verify-supabase-auth-env.mjs",
    "verify:supabase-login-routes": "node scripts/verify-supabase-login-routes.mjs",
    "db:apply:fire-biz": "node scripts/apply-fire-biz-production-migration.mjs",
    "db:apply:expense-transactions": "node scripts/apply-expense-transaction-history-migration.mjs",
    "db:apply:community-reviews": "node scripts/apply-community-reviews-migration.mjs",
    "db:apply:fire-ai": "node scripts/apply-fire-ai-migration.mjs",
    "db:apply:budget-records": "node scripts/apply-finance-budget-records-migration.mjs",
    "db:verify:budget-records": "node scripts/verify-finance-budget-records.mjs",
    "db:apply-verify:budget-records": "node scripts/apply-finance-budget-records-migration.mjs && node scripts/verify-finance-budget-records.mjs",
    "db:apply:group-expenses": "node scripts/apply-group-expenses-migration.mjs",
    "db:verify:group-expenses": "node scripts/verify-group-expenses-production.mjs",
    "db:apply-verify:group-expenses": "node scripts/apply-group-expenses-migration.mjs && node scripts/verify-group-expenses-production.mjs",
    "db:verify:community-reviews": "node scripts/verify-community-reviews-crud.mjs",
    "verify:fire-biz-production": "node scripts/verify-fire-biz-production-migration.mjs",
    "db:push:remote": "env SUPABASE_CLI_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1 npx --yes supabase@latest db push --db-url \"$SUPABASE_DB_URL\" --yes",
    "db:push-verify:production": "node scripts/push-verify-production-schema.mjs",
    "db:apply-verify:membership": "node scripts/apply-and-verify-supabase-membership.mjs",
    "revenue:backfill-membership": "node scripts/backfill-membership-revenue-events.mjs",
    "revenue:verify-membership": "node scripts/backfill-membership-revenue-events.mjs --verify-only",
    "nepse:backfill-eod": "node scripts/backfill-nepse-eod.mjs",
    "nepse:ingest-fundamentals": "node scripts/ingest-nepse-fundamentals.mjs",
    "nepse:ingest-statements": "npx tsx scripts/ingest-nepse-statements.ts",
    "nepse:audit-statements": "node scripts/audit-nepse-statements.mjs",
    "db:apply:nepse-statements": "node scripts/apply-nepse-company-statements-migration.mjs",
    "db:apply:nepse-hub-admin-overrides": "node scripts/apply-nepse-hub-admin-overrides-migration.mjs",
    "db:apply:insurance": "node scripts/apply-ensure-insurance-schema.mjs",
    "db:apply:savings-workspace": "node scripts/apply-finance-savings-workspace-migration.mjs",
    "db:apply:cashflow-snapshots": "node scripts/apply-cashflow-snapshots-migration.mjs",
    "db:apply:finance-sot": "node scripts/apply-all-finance-sot-migrations.mjs",
    "db:verify:finance-sot": "node scripts/verify-finance-sot-cross-browser.mjs",
    "db:apply-verify:finance-sot": "node scripts/apply-all-finance-sot-migrations.mjs && node scripts/verify-finance-sot-cross-browser.mjs",
    "db:verify:cashflow": "node scripts/verify-cashflow-production.mjs",
    "db:apply-verify:cashflow": "node scripts/apply-cashflow-snapshots-migration.mjs && node scripts/verify-cashflow-production.mjs",
    "test:insurance-cloud-primary": "node --test scripts/insurance-cloud-primary-dedupe.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "axios": "^1.16.1",
    "chart.js": "latest",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.40.0",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "nepali-date-converter": "^3.4.0",
    "next": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-chartjs-2": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-pin-input": "^1.3.1",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "pg": "^8.16.3",
    "playwright": "^1.61.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
