# Copy this file to the repository root as `.env.production.local` and replace placeholders.
# Never commit `.env.production.local` (it is gitignored).
#
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

# SERVER-ONLY (never NEXT_PUBLIC_*): admin inbox for signup + membership-request alerts via Resend.
# Set the real address in Vercel → Settings → Environment Variables or local `.env*.local` only — do not commit.
# Also requires RESEND_API_KEY and RESEND_FROM_EMAIL (or EMAIL_FROM).
# ADMIN_NOTIFICATION_EMAIL=admin@your-domain.com
ADMIN_NOTIFICATION_EMAIL=
