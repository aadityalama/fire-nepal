# Copy to `.env.local` — never commit real secrets.

# Canonical site origin for Supabase email links (password reset, sign-up confirmation).
# Required in Vercel Production so redirects in emails use https://firenepal.com (not localhost).
# Omit locally to default to the current browser origin (e.g. http://localhost:3000).
# NEXT_PUBLIC_SITE_URL=https://firenepal.com

# --- Live gold & silver (`/api/market/gold-price`) ---
# Primary: Nepal board rates are parsed from the public FENEGOSIDA homepage HTML (Fine Gold 9999 & Silver per 10 g and per tola).
# Secondary: international USD/troy oz (optional API keys below; else Yahoo GC=F / SI=F) is attached as reference only.
# GOLDAPI_API_KEY=
# METALS_DEV_API_KEY=
# METALPRICEAPI_KEY=

# --- FIRE Nepal AI (Ask FIRE AI — server-side only) ---
# OPENAI_API_KEY=

# --- Supabase (optional: enables cloud auth + portfolio sync) ---
# Dashboard → Project Settings → API. Use the Publishable key (`sb_publishable_…`) or legacy anon JWT (`eyJ…`) for NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Paste exactly — a single extra character causes Auth "Invalid API key". Verify with: node scripts/verify-supabase-auth-env.mjs
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres URI for CLI migrations (`npm run db:push:remote`, `npm run db:apply-verify:membership`). Dashboard → Connect → URI. Special chars in password must be percent-encoded (RFC 3986).
# SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: used by /api/cron/scheduled-reminders, membership payment proof uploads (auto-create storage bucket + upload), /admin exports, etc. (never expose to the client).

# --- Membership QR images (optional; defaults: /public/payment-qr/khalti.png, global-ime.png) ---
# NEXT_PUBLIC_MEMBERSHIP_QR_KHALTI=https://…
# NEXT_PUBLIC_MEMBERSHIP_QR_ESEWA=https://…
# NEXT_PUBLIC_MEMBERSHIP_QR_GLOBAL_IME=https://…

# --- Legacy product auth (email OTP via Resend on Vercel) ---
# Required in production when Supabase is not configured.
# When Supabase IS configured, password reset email is sent by Supabase Auth (dashboard SMTP), not Resend.
RESEND_API_KEY=
# Verified sender in Resend (must be a domain you've verified there).
# `EMAIL_FROM` is accepted as an alias for the same value.
RESEND_FROM_EMAIL="FIRE Nepal <onboarding@your-domain.com>"
# EMAIL_FROM=

# --- Admin transactional alerts (Resend; same RESEND_API_KEY / RESEND_FROM_EMAIL as above) ---
# SERVER-ONLY: set in Vercel / `.env*.local` only — never `NEXT_PUBLIC_*`. Do not log the value or return it from APIs.
# Receives new-user and new membership-request notifications from the app server.
ADMIN_NOTIFICATION_EMAIL=

# --- Automated smart-loan email reminders (Resend) ---
FIRE_NEPAL_LOGO_URL=https://firenepal.com/logo.png
CRON_SECRET=

# Optional server-side cron source until smart-loan profiles are synced to a database.
# SMART_LOAN_CRON_LOANS_JSON='[{"id":"loan-1","borrowerName":"Borrower","borrowerEmail":"borrower@example.com","borrowerPhone":"+9779800000000","lenderName":"Lender","lenderEmail":"lender@example.com","loanAmount":100000,"remainingAmount":50000,"agreementDate":"2026-05-01","dueDate":"2026-06-01","interestRate":12,"currency":"NPR","daysUntilDue":7,"daysOverdue":0}]'
SMART_LOAN_CRON_LOANS_JSON=

# Strong secret for signing session + pending-verification cookies (set in production).
# AUTH_SECRET=

# --- NEPSE Hub automatic data engine (/api/cron/nepse-market-data) ---
# Required for news aggregation. Comma-separated "Source Name|https://feed-url" pairs.
# Only headline, source link, publish time and a short snippet are stored — never article bodies.
# ShareSansar / MeroLagani / NepaliPaisa do not expose official public RSS; use licensed feeds or
# community RSS mirrors. Verified working starter set:
NEPSE_NEWS_FEEDS=Kathmandu Post|https://kathmandupost.com/rss,NEPSE Announcements|https://jarp0l.github.io/nepse-rss/announcements.xml,NEPSE Stocks|https://jarp0l.github.io/nepse-rss/stocks.xml
# Also ensure on Vercel Production:
#   NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET (recommended), NEPSE_NEWS_FEEDS
# Company fundamentals tables (nepse_company_profiles/valuation/financials/dividends/actions)
# are populated by a licensed provider via service-role upserts — never hardcode per-symbol values.
# Historical OHLC backfill uses the public ShareSansar archive automatically inside
# /api/cron/nepse-market-data (and scripts/backfill-nepse-eod.mjs for bulk seeding).
#
# Complete financial statements (nepse_company_statements) are ingested incrementally by the
# same cron (kind=statements) from official NEPSE fiscal reports + text-extractable PDFs.
# Apply migration: supabase/migrations/20260727120000_nepse_company_statements.sql
# Manual backfill: npm run nepse:ingest-statements -- --limit=400 --pdfLimit=200
# Coverage audit:  npm run nepse:audit-statements
# Cron query params: statements=0 to skip; statementLimit; pdfLimit; pdfs=0
